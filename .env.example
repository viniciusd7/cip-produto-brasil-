# ===========================================
# CIP Plataforma — Variáveis de Ambiente
# Copie para .env e ajuste os valores
# ===========================================

# MySQL (local Docker ou HostGator remoto)
DATABASE_URL="mysql://cip:cip_secret@localhost:3306/cip_gestao"

# Auth (NextAuth / Auth.js)
# Em produção: gere um secret forte (≥32 bytes) e use o MESMO valor na web e na API.
# A API recusa boot em produção sem NEXTAUTH_SECRET/JWT_SECRET.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-secret-longo-e-aleatorio"

# API
API_PORT=4000
API_URL="http://localhost:4000"
# Origens exatas do front, separadas por vírgula (nunca use * com credentials):
# ambiente das prefeituras + console da equipe CIP (gestao.<domínio>).
CORS_ORIGIN="http://localhost:3000,http://gestao.localhost:3000"

# Console da equipe CIP em host separado. Local: http://gestao.localhost:3000
# GESTAO_HOST="gestao.cipinteligenciapublica.com.br"
# NEXT_PUBLIC_GESTAO_URL="https://gestao.cipinteligenciapublica.com.br"
# NEXT_PUBLIC_APP_URL="https://app.cipinteligenciapublica.com.br"

# Frontend → API
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Demo UI (login com contas locais). Deixe false/ausente em produção.
NEXT_PUBLIC_DEMO_MODE="true"

# Ambiente
NODE_ENV="development"
# Seed demo em produção: bloqueado, salvo CIP_ALLOW_DEMO_SEED=true (ambiente isolado)
# CIP_ALLOW_DEMO_SEED="false"
