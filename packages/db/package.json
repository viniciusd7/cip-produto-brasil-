{
  "name": "@cip/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:modelos": "tsx prisma/seed-demo-modelos.ts",
    "convert:modelos": "tsx prisma/run-convert-demo-local.ts",
    "typecheck:demo": "tsc -p tsconfig.demo.json",
    "test:demo": "tsx --test prisma/demo-modelos.test.ts",
    "test:conversion": "tsx --test prisma/convert-demo-local.test.ts",
    "test": "tsx --test prisma/*.test.ts",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:demo",
    "lint": "echo \"no lint configured\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
