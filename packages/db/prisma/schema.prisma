generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== Auth / RBAC ==========

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  active          Boolean  @default(true)
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles                 UserRole[]
  vinculos              VinculoUsuarioMunicipio[]
  prefeiturasConsultor  Municipio[]               @relation("MunicipioConsultorResponsavel")
  sessions              SessionToken[]
  auditLogs             AuditLog[]                @relation("AuditActor")
  reprogramacoes        Reprogramacao[]
  decisoes              DecisaoProvidencia[]
  validacoesEvidencia   ValidacaoEvidencia[]
  comunicadosEnviados   Comunicado[]              @relation("ComunicadoAutor")
  comunicadosRecebidos  Comunicado[]              @relation("ComunicadoDestino")
  leiturasComunicado    ComunicadoLeitura[]
  importacoes           ImportacaoSnapshot[]
  sugestoesIa           SugestaoIA[]              @relation("SugestaoAutor")
  decisoesSugestaoIa    SugestaoIA[]              @relation("SugestaoDecisor")
  solicitacoesValidacao SolicitacaoValidacao[]    @relation("SolicitacaoAutor")
  decisoesValidacao     DecisaoValidacao[]        @relation("DecisaoValidador")
  dependenciasCriadas   DependenciaVinculo[]      @relation("DependenciaAutor")
  dependenciasValidadas DependenciaVinculo[]      @relation("DependenciaValidador")
  medicoes              Medicao[]                 @relation("MedicaoAutor")
  metasEstrategicasResp MetaEstrategica[]         @relation("MetaEstrategicaResponsavel")
  metasExecucaoResp     MetaExecucao[]            @relation("MetaExecucaoResponsavel")
  tarefasResp           MarcoEntrega[]            @relation("MarcoResponsavel")
  subtarefasResp        Subtarefa[]               @relation("SubtarefaResponsavel")
  indicadoresResp       Indicador[]               @relation("IndicadorResponsavel")
  notificacoes          Notificacao[]             @relation("NotificacaoDestino")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SessionToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========== Organização municipal ==========

model Municipio {
  id                     String    @id @default(cuid())
  nome                   String
  uf                     String    @db.VarChar(2)
  ibgeCode               String?   @unique
  /**
   * CNPJ do órgão (só dígitos) para consultas Transferegov/PNCP.
   */
  cnpjOrgao              String?   @db.VarChar(14)
  mandatoInicio          DateTime?
  mandatoFim             DateTime?
  prefeitoNome           String?
  prefeitoTelefone       String?
  prefeitoEmail          String?
  consultorResponsavelId String?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  secretarias           Secretaria[]
  vinculos              VinculoUsuarioMunicipio[]
  consultorResponsavel  User?                     @relation("MunicipioConsultorResponsavel", fields: [consultorResponsavelId], references: [id], onDelete: SetNull)
  compromissos          Compromisso[]
  iniciativas           Iniciativa[]
  equipamentos          EquipamentoPublico[]
  importacoes           ImportacaoSnapshot[]
  planos                PlanoGoverno[]
  modelosProjeto        ModeloProjeto[]
  documentos            DocumentoConhecimento[]
  dependencias          DependenciaVinculo[]
  sugestoesIa           SugestaoIA[]
  solicitacoesValidacao SolicitacaoValidacao[]
  medicoes              Medicao[]
  indicadores           Indicador[]
  notificacoes          Notificacao[]

  @@index([consultorResponsavelId])
}

model VinculoUsuarioMunicipio {
  id           String      @id @default(cuid())
  userId       String
  municipioId  String
  secretariaId String?
  roleCode     String      @default("leitura")
  principal    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipio    Municipio   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  @@unique([userId, municipioId])
  @@index([municipioId])
  @@index([secretariaId])
}

model PlanoGoverno {
  id            String            @id @default(cuid())
  municipioId   String
  nome          String
  periodo       String?
  descricao     String?           @db.Text
  mandatoInicio DateTime?
  mandatoFim    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  municipio     Municipio         @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  metas         MetaEstrategica[]

  @@index([municipioId])
}

model Secretaria {
  id              String                    @id @default(cuid())
  municipioId     String
  nome            String
  sigla           String?
  titularNome     String?
  titularCargo    String?
  titularTelefone String?
  titularEmail    String?
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  municipio       Municipio                 @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  metas           MetaEstrategica[]
  iniciativas     Iniciativa[]              @relation("SecretariaPrincipal")
  vinculos        IniciativaSecretaria[]
  usuariosVinculo VinculoUsuarioMunicipio[]
  pessoas         SecretariaPessoa[]

  @@unique([municipioId, nome])
  @@index([municipioId])
}

model SecretariaPessoa {
  id           String   @id @default(cuid())
  secretariaId String
  nome         String
  cargo        String
  telefone     String?
  email        String?
  papel        String   @default("EQUIPE") // TITULAR | EQUIPE
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  secretaria  Secretaria   @relation(fields: [secretariaId], references: [id], onDelete: Cascade)
  iniciativas Iniciativa[] @relation("ResponsavelPessoa")

  @@index([secretariaId])
  @@index([secretariaId, ativo])
}

model MetaEstrategica {
  id                String       @id @default(cuid())
  planoId           String
  secretariaId      String?
  codigo            String?
  nome              String
  descricao         String?      @db.Text
  indicador         String?
  valorBase         String?
  alvo              String?
  unidade           String?
  periodicidade     String?
  prazo             DateTime?
  statusValidacao   String       @default("PENDENTE") // PENDENTE | VALIDADO | REJEITADO
  perspectivaBsc    String? // FINANCEIRA | CLIENTES | PROCESSOS | APRENDIZADO
  resultadoChaveOkr String?
  responsavelUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  plano             PlanoGoverno @relation(fields: [planoId], references: [id], onDelete: Cascade)
  secretaria        Secretaria?  @relation(fields: [secretariaId], references: [id])
  responsavelUser   User?        @relation("MetaEstrategicaResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  iniciativas       Iniciativa[]
  medicoes          Medicao[]
  indicadores       Indicador[]

  @@index([planoId])
  @@index([secretariaId])
  @@index([responsavelUserId])
}

// ========== Compromissos e Iniciativas ==========

model Compromisso {
  id          String                  @id @default(cuid())
  municipioId String
  codigo      String?
  titulo      String
  fonte       String?
  descricao   String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  municipio   Municipio               @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  vinculos    IniciativaCompromisso[]

  @@index([municipioId])
}

model Iniciativa {
  id                     String    @id @default(cuid())
  municipioId            String
  secretariaPrincipalId  String
  metaEstrategicaId      String?
  codigo                 String
  nome                   String
  descricao              String?   @db.Text
  tipo                   String?
  origem                 String?
  responsavel            String?
  responsavelPessoaId    String?
  ciclo                  String    @default("EM_ACOMPANHAMENTO")
  publicacao             String    @default("INTERNA")
  dataReferencia         DateTime?
  fonte                  String?
  confiabilidade         String?   @default("MEDIA")
  estruturante           Boolean   @default(false)
  classificacaoPrincipal String?
  vinculoPlanoGoverno    Boolean   @default(false)
  modeloProjetoId        String?
  modeloSnapshot         Json?
  bloqueioLabel          String?
  bloqueiosAtivos        Json?
  prioridadeNivel        String?
  etapaAtual             String?
  prontidaoPct           Int?
  criadoPorId            String?
  atualizadoEm           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  municipio            Municipio                       @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  secretariaPrincipal  Secretaria                      @relation("SecretariaPrincipal", fields: [secretariaPrincipalId], references: [id])
  metaEstrategica      MetaEstrategica?                @relation(fields: [metaEstrategicaId], references: [id])
  modeloProjeto        ModeloProjeto?                  @relation(fields: [modeloProjetoId], references: [id])
  responsavelPessoa    SecretariaPessoa?               @relation("ResponsavelPessoa", fields: [responsavelPessoaId], references: [id])
  secretarias          IniciativaSecretaria[]
  compromissos         IniciativaCompromisso[]
  metasExecucao        MetaExecucao[]
  marcos               MarcoEntrega[]
  verificacoes         Verificacao[]
  impedimentos         Impedimento[]
  decisoes             DecisaoProvidencia[]
  evidencias           Evidencia[]
  equipamentos         IniciativaEquipamento[]
  comunicados          Comunicado[]
  respostasViabilidade IniciativaRespostaViabilidade[]
  itensGeradosOrigem   ItemGeradoOrigem[]
  documentos           IniciativaDocumento[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
  @@index([secretariaPrincipalId])
  @@index([ciclo])
  @@index([modeloProjetoId])
  @@index([responsavelPessoaId])
}

model MetaExecucao {
  id                String    @id @default(cuid())
  iniciativaId      String
  codigo            String?
  nome              String
  indicador         String?
  criterio          String?   @db.Text
  alvo              String?
  valorAtual        String?
  unidade           String?
  responsavel       String?
  responsavelUserId String?
  prazo             DateTime?
  status            String    @default("EM_ANDAMENTO")
  ordem             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  iniciativa      Iniciativa     @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  responsavelUser User?          @relation("MetaExecucaoResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  marcos          MarcoEntrega[]
  medicoes        Medicao[]
  indicadores     Indicador[]

  @@index([iniciativaId])
  @@index([responsavelUserId])
}

model Medicao {
  id                String   @id @default(cuid())
  municipioId       String
  metaEstrategicaId String?
  metaExecucaoId    String?
  indicadorId       String?
  dataCorte         DateTime
  valorRealizado    String
  valorEsperado     String?
  fonte             String?
  confiabilidade    String?  @default("MEDIA")
  observacao        String?  @db.Text
  autorId           String?
  createdAt         DateTime @default(now())

  municipio       Municipio        @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  metaEstrategica MetaEstrategica? @relation(fields: [metaEstrategicaId], references: [id], onDelete: Cascade)
  metaExecucao    MetaExecucao?    @relation(fields: [metaExecucaoId], references: [id], onDelete: Cascade)
  indicador       Indicador?       @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  autor           User?            @relation("MedicaoAutor", fields: [autorId], references: [id])

  @@index([municipioId])
  @@index([indicadorId, dataCorte])
  @@index([metaEstrategicaId, dataCorte])
  @@index([metaExecucaoId, dataCorte])
}

/// Indicador mensurável de uma meta estratégica (ou de execução), com série de medições.
model Indicador {
  id                String   @id @default(cuid())
  municipioId       String
  metaEstrategicaId String?
  metaExecucaoId    String?
  nome              String
  descricao         String?  @db.Text
  formula           String?  @db.Text
  unidade           String?
  valorBase         String?
  alvo              String?
  valorAtual        String?
  periodicidade     String?
  fonte             String?
  polaridade        String   @default("MAIOR_MELHOR") // MAIOR_MELHOR | MENOR_MELHOR
  responsavelUserId String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  municipio       Municipio        @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  metaEstrategica MetaEstrategica? @relation(fields: [metaEstrategicaId], references: [id], onDelete: Cascade)
  metaExecucao    MetaExecucao?    @relation(fields: [metaExecucaoId], references: [id], onDelete: Cascade)
  responsavelUser User?            @relation("IndicadorResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  medicoes        Medicao[]

  @@index([municipioId])
  @@index([metaEstrategicaId])
  @@index([metaExecucaoId])
  @@index([responsavelUserId])
}

model IniciativaSecretaria {
  id           String     @id @default(cuid())
  iniciativaId String
  secretariaId String
  papel        String     @default("CORRESPONSAVEL")
  responsavel  String?
  iniciativa   Iniciativa @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  secretaria   Secretaria @relation(fields: [secretariaId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, secretariaId])
}

model IniciativaCompromisso {
  id               String      @id @default(cuid())
  iniciativaId     String
  compromissoId    String
  tipoContribuicao String?
  origemVinculo    String?
  iniciativa       Iniciativa  @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  compromisso      Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, compromissoId])
}

model EquipamentoPublico {
  id          String                  @id @default(cuid())
  municipioId String
  nome        String
  tipo        String?
  endereco    String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  municipio   Municipio               @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  iniciativas IniciativaEquipamento[]
  marcos      MarcoEntrega[]

  @@unique([municipioId, nome])
  @@index([municipioId])
}

model IniciativaEquipamento {
  id            String             @id @default(cuid())
  iniciativaId  String
  equipamentoId String
  tipoVinculo   String             @default("RELACIONADO")
  validado      Boolean            @default(false)
  iniciativa    Iniciativa         @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  equipamento   EquipamentoPublico @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, equipamentoId])
}

// ========== Marcos / Tarefas ==========

model MarcoEntrega {
  id                    String    @id @default(cuid())
  iniciativaId          String
  metaExecucaoId        String?
  equipamentoId         String?
  codigo                String?
  descricao             String    @db.Text
  ordem                 Int       @default(0)
  responsavel           String?
  responsavelUserId     String?
  prazoOriginal         DateTime?
  prazoVigente          DateTime?
  concluidoEm           DateTime?
  encerradoSemSolucaoEm DateTime?
  motivoEncerramento    String?   @db.Text
  gravidade             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  iniciativa      Iniciativa          @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  metaExecucao    MetaExecucao?       @relation(fields: [metaExecucaoId], references: [id])
  equipamento     EquipamentoPublico? @relation(fields: [equipamentoId], references: [id])
  responsavelUser User?               @relation("MarcoResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)
  reprogramacoes  Reprogramacao[]
  subtarefas      Subtarefa[]
  evidencias      Evidencia[]
  impedimentos    Impedimento[]

  @@index([iniciativaId])
  @@index([metaExecucaoId])
  @@index([prazoVigente])
  @@index([responsavelUserId])
}

model Subtarefa {
  id                String       @id @default(cuid())
  marcoId           String
  descricao         String       @db.Text
  responsavel       String?
  responsavelUserId String?
  prazo             DateTime?
  concluida         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  marco             MarcoEntrega @relation(fields: [marcoId], references: [id], onDelete: Cascade)
  responsavelUser   User?        @relation("SubtarefaResponsavel", fields: [responsavelUserId], references: [id], onDelete: SetNull)

  @@index([marcoId])
  @@index([responsavelUserId])
}

model Reprogramacao {
  id           String       @id @default(cuid())
  marcoId      String
  dataAnterior DateTime?
  dataNova     DateTime
  motivo       String       @db.Text
  autorId      String?
  autorizacao  String?
  createdAt    DateTime     @default(now())
  marco        MarcoEntrega @relation(fields: [marcoId], references: [id], onDelete: Cascade)
  autor        User?        @relation(fields: [autorId], references: [id])

  @@index([marcoId])
}

// ========== Verificações / Impedimentos / Decisões ==========

model TipoVerificacao {
  id           String        @id @default(cuid())
  codigo       String        @unique
  nome         String
  descricao    String?       @db.Text
  active       Boolean       @default(true)
  verificacoes Verificacao[]
}

model Verificacao {
  id                String          @id @default(cuid())
  iniciativaId      String
  tipoVerificacaoId String
  aplicabilidade    String          @default("A_AVALIAR")
  situacao          String          @default("NAO_INICIADA")
  responsavel       String?
  justificativa     String?         @db.Text
  documentoFonte    String?
  efeitoNoAvanco    String          @default("INFORMATIVO")
  proximaAcao       String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  iniciativa        Iniciativa      @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  tipo              TipoVerificacao @relation(fields: [tipoVerificacaoId], references: [id])

  @@unique([iniciativaId, tipoVerificacaoId])
  @@index([iniciativaId])
}

model Impedimento {
  id           String               @id @default(cuid())
  iniciativaId String
  marcoId      String?
  tipo         String?
  descricao    String               @db.Text
  gravidade    String               @default("MEDIA")
  responsavel  String?
  status       String               @default("ABERTO")
  proximoPasso String?              @db.Text
  prazo        DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  iniciativa   Iniciativa           @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  marco        MarcoEntrega?        @relation(fields: [marcoId], references: [id])
  decisoes     DecisaoProvidencia[]

  @@index([iniciativaId])
  @@index([status])
}

model DecisaoProvidencia {
  id            String       @id @default(cuid())
  iniciativaId  String
  impedimentoId String?
  descricao     String       @db.Text
  responsavel   String?
  autorId       String?
  prazo         DateTime?
  status        String       @default("ABERTA")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  iniciativa    Iniciativa   @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  impedimento   Impedimento? @relation(fields: [impedimentoId], references: [id])
  autor         User?        @relation(fields: [autorId], references: [id])

  @@index([iniciativaId])
}

// ========== Evidências ==========

model Evidencia {
  id           String               @id @default(cuid())
  iniciativaId String
  marcoId      String?
  titulo       String
  descricao    String?              @db.Text
  tipo         String? // FOTO | DOCUMENTO | LINK
  urlOuArquivo String?
  mimeType     String?
  tamanhoBytes Int?
  arquivoNome  String?
  fonte        String?
  autorNome    String?
  status       String               @default("DECLARADA")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  iniciativa   Iniciativa           @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  marco        MarcoEntrega?        @relation(fields: [marcoId], references: [id])
  validacoes   ValidacaoEvidencia[]

  @@index([iniciativaId])
  @@index([status])
}

model ValidacaoEvidencia {
  id          String    @id @default(cuid())
  evidenciaId String
  validadorId String?
  status      String
  parecer     String?   @db.Text
  createdAt   DateTime  @default(now())
  evidencia   Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)
  validador   User?     @relation(fields: [validadorId], references: [id])

  @@index([evidenciaId])
}

// ========== Importação / Auditoria ==========

model ImportacaoSnapshot {
  id             String               @id @default(cuid())
  municipioId    String
  autorId        String?
  nomeArquivo    String
  dataReferencia DateTime
  fonte          String?
  totalLinhas    Int                  @default(0)
  importadas     Int                  @default(0)
  conflitos      Int                  @default(0)
  resultado      String               @default("PENDENTE")
  mapaCampos     Json?
  log            String?              @db.LongText
  createdAt      DateTime             @default(now())
  municipio      Municipio            @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  autor          User?                @relation(fields: [autorId], references: [id])
  itensConflito  ImportacaoConflito[]

  @@index([municipioId])
}

model ImportacaoConflito {
  id           String             @id @default(cuid())
  importacaoId String
  chaveExterna String
  campo        String?
  valorAtual   String?            @db.Text
  valorNovo    String?            @db.Text
  resolvido    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  importacao   ImportacaoSnapshot @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([importacaoId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  municipioId String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([municipioId])
  @@index([createdAt])
}

model Relatorio {
  id          String   @id @default(cuid())
  municipioId String
  titulo      String
  tipo        String
  filtros     Json?
  geradoPorId String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  @@index([municipioId])
}

// ========== Modelos de projeto / wizard de viabilidade ==========

model ModeloProjetoCatalogo {
  id        String          @id @default(cuid())
  codigo    String          @unique
  nome      String
  descricao String?         @db.Text
  categoria String?
  ativo     Boolean         @default(true)
  versao    Int             @default(1)
  snapshot  Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  ativacoes ModeloProjeto[]
}

model ModeloProjeto {
  id                       String   @id @default(cuid())
  municipioId              String
  catalogoOrigemId         String?
  codigo                   String
  nome                     String
  descricao                String?  @db.Text
  classificacoesPermitidas Json
  ativo                    Boolean  @default(true)
  snapshotVersion          Int      @default(1)
  snapshot                 Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  municipio      Municipio              @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  catalogoOrigem ModeloProjetoCatalogo? @relation(fields: [catalogoOrigemId], references: [id])
  perguntas      ModeloPergunta[]
  estrutura      ModeloEstruturaItem[]
  iniciativas    Iniciativa[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
}

model ModeloPergunta {
  id                  String   @id @default(cuid())
  modeloId            String
  codigo              String
  texto               String   @db.Text
  tipoResposta        String
  impacto             String
  obrigatoria         Boolean  @default(false)
  ordem               Int      @default(0)
  dependeDePerguntaId String?
  dependeDeValor      Json?
  opcoes              Json?
  efeitos             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  modelo            ModeloProjeto    @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  dependeDePergunta ModeloPergunta?  @relation("PerguntaDependencia", fields: [dependeDePerguntaId], references: [id])
  dependentes       ModeloPergunta[] @relation("PerguntaDependencia")

  @@unique([modeloId, codigo])
  @@index([modeloId])
}

model ModeloEstruturaItem {
  id            String   @id @default(cuid())
  modeloId      String
  codigo        String
  nivel         String
  parentCodigo  String?
  nome          String
  indicador     String?
  alvo          String?
  ordem         Int      @default(0)
  sempreIncluir Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modelo ModeloProjeto @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@unique([modeloId, codigo])
  @@index([modeloId])
}

model IniciativaRespostaViabilidade {
  id             String   @id @default(cuid())
  iniciativaId   String
  perguntaCodigo String
  perguntaTexto  String   @db.Text
  valor          Json
  impacto        String
  autorId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  iniciativa Iniciativa                    @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  historico  IniciativaRespostaHistorico[]

  @@unique([iniciativaId, perguntaCodigo])
  @@index([iniciativaId])
}

model IniciativaRespostaHistorico {
  id            String   @id @default(cuid())
  respostaId    String
  valorAnterior Json?
  valorNovo     Json
  autorId       String?
  createdAt     DateTime @default(now())

  resposta IniciativaRespostaViabilidade @relation(fields: [respostaId], references: [id], onDelete: Cascade)

  @@index([respostaId])
}

model ItemGeradoOrigem {
  id                    String   @id @default(cuid())
  iniciativaId          String
  metaExecucaoId        String?
  marcoId               String?
  subtarefaId           String?
  perguntaCodigo        String?
  valorQueGerou         String?
  modeloEstruturaCodigo String?
  createdAt             DateTime @default(now())

  iniciativa Iniciativa @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)

  @@index([iniciativaId])
}

model Comunicado {
  id             String              @id @default(cuid())
  iniciativaId   String
  autorId        String?
  destinatarioId String?
  destinoPapel   String?
  texto          String              @db.Text
  tipo           String              @default("MENSAGEM")
  createdAt      DateTime            @default(now())
  iniciativa     Iniciativa          @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  autor          User?               @relation("ComunicadoAutor", fields: [autorId], references: [id])
  destinatario   User?               @relation("ComunicadoDestino", fields: [destinatarioId], references: [id])
  leituras       ComunicadoLeitura[]

  @@index([iniciativaId, createdAt])
  @@index([destinatarioId])
}

model ComunicadoLeitura {
  comunicadoId String
  userId       String
  lidoEm       DateTime   @default(now())
  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comunicadoId, userId])
}

// ========== Dossiê Izabela: vínculos, KB, IA, tramitação ==========

model DependenciaVinculo {
  id            String    @id @default(cuid())
  municipioId   String
  origemTipo    String // MARCO | INICIATIVA
  origemId      String
  destinoTipo   String // MARCO | INICIATIVA
  destinoId     String
  tipo          String    @default("IMPEDITIVA") // IMPEDITIVA | INFORMATIVA | COMPARTILHADA
  sentido       String    @default("ORIGEM_BLOQUEIA_DESTINO")
  justificativa String    @db.Text
  status        String    @default("PENDENTE") // PENDENTE | VALIDADO | REJEITADO
  autorId       String?
  validadorId   String?
  validadoEm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  autor     User?     @relation("DependenciaAutor", fields: [autorId], references: [id])
  validador User?     @relation("DependenciaValidador", fields: [validadorId], references: [id])

  @@index([municipioId])
  @@index([origemTipo, origemId])
  @@index([destinoTipo, destinoId])
  @@index([status])
}

model DocumentoConhecimento {
  id                String   @id @default(cuid())
  municipioId       String
  tipo              String // PPA | LDO | LOA | DIAGNOSTICO | OUTRO
  titulo            String
  vigencia          String?
  versao            String?
  fonte             String?
  responsavel       String?
  statusConferencia String   @default("PENDENTE") // PENDENTE | CONFERIDO | DESATUALIZADO
  arquivoUrl        String?
  arquivoNome       String?  @db.Text
  storageKey        String?  @db.Text
  conteudoExtraido  String?  @db.Text
  observacao        String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  municipio Municipio             @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  vinculos  IniciativaDocumento[]

  @@index([municipioId, tipo])
  @@index([statusConferencia])
}

model IniciativaDocumento {
  id           String                @id @default(cuid())
  iniciativaId String
  documentoId  String
  papel        String                @default("REFERENCIA") // REFERENCIA | ORCAMENTO | COMPROVACAO
  iniciativa   Iniciativa            @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  documento    DocumentoConhecimento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, documentoId])
}

model SugestaoIA {
  id           String    @id @default(cuid())
  municipioId  String
  entidadeTipo String // META_ESTRATEGICA | INICIATIVA | MARCO | DOCUMENTO | CAMPO
  entidadeId   String?
  campo        String?
  sugestao     String    @db.Text
  fonte        String?
  confianca    String    @default("BAIXA") // BAIXA | MEDIA | ALTA
  status       String    @default("PENDENTE") // PENDENTE | ACEITA | REJEITADA
  autorId      String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  autor     User?     @relation("SugestaoAutor", fields: [autorId], references: [id])
  decidedBy User?     @relation("SugestaoDecisor", fields: [decidedById], references: [id])

  @@index([municipioId, status])
  @@index([entidadeTipo, entidadeId])
}

model SolicitacaoValidacao {
  id            String   @id @default(cuid())
  municipioId   String
  entidadeTipo  String
  entidadeId    String
  tipo          String   @default("REVISAO") // REVISAO | APROVACAO | VINCULO
  justificativa String   @db.Text
  payload       Json?
  status        String   @default("ABERTA") // ABERTA | DECIDIDA | CANCELADA
  autorId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  municipio Municipio          @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  autor     User?              @relation("SolicitacaoAutor", fields: [autorId], references: [id])
  decisoes  DecisaoValidacao[]

  @@index([municipioId, status])
  @@index([entidadeTipo, entidadeId])
}

model DecisaoValidacao {
  id            String   @id @default(cuid())
  solicitacaoId String
  resultado     String // APROVADA | REJEITADA | DEVOLVIDA
  parecer       String   @db.Text
  validadorId   String?
  createdAt     DateTime @default(now())

  solicitacao SolicitacaoValidacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  validador   User?                @relation("DecisaoValidador", fields: [validadorId], references: [id])

  @@index([solicitacaoId])
}

/// Notificação interna por usuário; canais externos (SMTP/WhatsApp) consomem a mesma origem.
model Notificacao {
  id           String    @id @default(cuid())
  municipioId  String
  userId       String
  tipo         String // ATRIBUICAO | VALIDACAO_PENDENTE | VALIDACAO_DECIDIDA | REPROGRAMACAO
  titulo       String
  texto        String    @db.Text
  link         String?
  entidadeTipo String?
  entidadeId   String?
  lidaEm       DateTime?
  createdAt    DateTime  @default(now())

  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificacaoDestino", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, municipioId, lidaEm])
}
